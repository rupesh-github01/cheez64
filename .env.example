# ==============================================================================
# Personal Chess Coach — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure values as needed.
# DO NOT commit real secrets or credentials to source control.

# ------------------------------------------------------------------------------
# 1. Database & Local Storage
# ------------------------------------------------------------------------------
# Path to SQLite database (relative to repo root or absolute path).
# Default: data/library.db
CHESS_COACH_DB=data/library.db

# ------------------------------------------------------------------------------
# 2. Stockfish Chess Engine
# ------------------------------------------------------------------------------
# Path to Stockfish UCI executable binary.
# Automatically detected in PATH (shutil.which) or /opt/homebrew/bin/stockfish on macOS.
# Override here if Stockfish is installed in a custom location.
# macOS (Homebrew): /opt/homebrew/bin/stockfish
# Linux: /usr/games/stockfish or /usr/local/bin/stockfish
# Windows: C:\stockfish\stockfish.exe
# STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# ------------------------------------------------------------------------------
# 3. API & Frontend URLs
# ------------------------------------------------------------------------------
# FastAPI Backend host and port (defaults: 0.0.0.0:8000)
API_HOST=0.0.0.0
API_PORT=8000

# Next.js API endpoint URL used by client-side components.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. Optional External LLM Provider (Segment 9)
# ------------------------------------------------------------------------------
# NOTE: The Personal Chess Coach functions COMPLETELY OFFLINE with a deterministic
# rule- and evidence-grounded coach fallback when no API key is provided.
# External LLM access is OPTIONAL and may incur API usage charges.

# Provider mode: 'deterministic' (default offline fallback) | 'openai'
# CHESS_COACH_LLM_PROVIDER=deterministic

# OpenAI-compatible API credentials (OpenAI, Groq, Ollama, DeepSeek, etc.)
# Leave empty to keep using the free, local deterministic coach.
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHESS_COACH_LLM_TIMEOUT=15.0
